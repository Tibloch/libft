#include <stdlib.h>
#include <stdio.h>

int	count_word(char const *s, char c)
{
	int	i;
	int	ct;

	i = 0;
	ct = 0;
	while (s[i])
	{
		while (s[i] == c)
			i++;
		while (s[i] && s[i] != c)
			i++;
		ct++;
	}
	return (ct);
}

int	count_letter(char const *s, char c, int *j)
{
	int	ct;

	ct = 0;
	while (s[*j] == c)
		(*j)++;
	while (s[*j] && s[*j] != c)
	{
		(*j)++;
		ct++;
	}
	return (ct);
}

void	fill_array(char *str, char const *s, char c, int start)
{
	int	i;

	i = 0;
	while (s[start] && s[start] != c)
	{
		str[i] = s[start];
		start++;
	}
}

char	**ft_split(char const *s, char c)
{
	int	i;
	int	j;
	int	ct_w;
	int	ct_l;
	char	**array;

	ct_w = count_word(s, c);
	array = malloc(sizeof(char *) * (ct_w + 1));
	if (!array)
		return (NULL);
	while (ct_w > 0)
	{
		ct_l = count_letter(s, c, &j);
		array[i] = malloc(sizeof(char) * (ct_l + 1));
		if (!array[i])
			return (NULL);
		fill_array(array[i], s, c, j - ct_l);
		ct_w--;
	}
	return (array);
}

int	main()
{
	char **array = ft_split("un premier teste", ' ');
	for (int i = 0; array[i]; i++)
		printf("%s\n", array[i]);
}
